{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "ignoreTests": false,
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Keep extraction enabled but disable ordinary dependency updates after lookup",
      "matchManagers": [
        "npm"
      ],
      "matchJsonata": [
        "$exists(updateType) and ($not($exists(isVulnerabilityAlert)) or isVulnerabilityAlert = false)"
      ],
      "enabled": false
    },
    {
      "description": "Only CRITICAL GitHub vulnerability alerts are eligible; the trusted runner verifies and merges exact SHAs",
      "matchManagers": [
        "npm"
      ],
      "matchJsonata": [
        "isVulnerabilityAlert and ($not($exists(vulnerabilitySeverity)) or vulnerabilitySeverity != 'CRITICAL')"
      ],
      "enabled": false
    }
  ]
}
